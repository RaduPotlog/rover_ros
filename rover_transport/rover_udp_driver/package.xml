<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_udp_driver</name>
  <version>2.0.0</version>
  <description>
    Lifecycle nodes that bridge UDP to ROS 2: a receiver that republishes every datagram on
    udp_read, and a sender that transmits packets received on udp_write while active, plus
    a combined bridge sharing one IO context. Forked from transport_drivers' udp_driver
    (v1.2.0); see README.md for provenance.
  </description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>

  <url type="repository">https://github.com/ros-drivers/transport_drivers</url>

  <author email="opensource@apex.ai">Apex.AI, Inc.</author>
  <author email="esteve@apache.org">Esteve Fernandez</author>
  <author>LeoDrive</author>
  <author>The Autoware Foundation</author>
  <author>Evan Flynn</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rover_asio_cmake_module</buildtool_depend>

  <depend>asio</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rover_io_context</depend>
  <depend>udp_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
