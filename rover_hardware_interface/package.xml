<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_hardware_interface</name>
  <version>1.0.1</version>
  <description>ROS2 hardware interface controller for rover</description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <build_depend>autoconf</build_depend>
  <build_depend>autoconf-archive</build_depend>
  <build_depend>libtool</build_depend>
  <build_depend>m4</build_depend>
  <build_depend>pkg-config</build_depend>

  <depend>diagnostic_updater</depend>
  <depend>generate_parameter_library</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>imu_filter_madgwick</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <!-- Build-order only: imu_filter_madgwick's exported CMake target links against these; see
       CMakeLists.txt for the full explanation. -->
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Rover messages and services -->
  <depend>rover_msgs</depend>
    
  <!-- Phidgets API -->
  <depend>phidgets_api</depend>

  <!-- Modbus_Core (from the sibling rover_modbus repo) is a plain CMake package, not an ament
       package, so it cannot be expressed as a depend here and rosdep/colcon cannot resolve or
       order it. It must be built and installed (via CMake's install step) to a prefix on
       CMAKE_PREFIX_PATH before this package is built - see CMakeLists.txt and
       src/rover_modbus/README.md. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <!-- Pulls in cpplint/cppcheck/lint_cmake/xmllint/copyright/uncrustify; uncrustify is
       explicitly excluded in CMakeLists.txt via AMENT_LINT_AUTO_EXCLUDE, since this repo
       consistently uses 4-space indentation rather than uncrustify's default Google C++
       style. -->
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
