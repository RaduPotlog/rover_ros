<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_crfs_teleop</name>
  <version>1.1.0</version>
  <description>CRSF (ExpressLRS) RC teleop for the rover: sticks to cmd_vel, switches to the SW E-Stop, with an RC link failsafe.</description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <!-- Message definitions only: needed to build in every profile, not just on hardware. -->
  <depend>crsf_receiver_msg</depend>

  <!-- Rover real hardware dependency: the serial receiver driver started by the launch file. -->
  <exec_depend condition="$ROVER_ROS_BUILD_TYPE == hardware">crsf_receiver</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
