<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!-- led_*_verdict and led_battery_* are computed by rover_safety::domain::evaluateLedAnimation. current_*_anim_id and charging_anim_percent record what the tree last sent. -->
  <BehaviorTree ID="BatteryAnimationSubtree">
    <Sequence>
      <Parallel name="ChargingSequence"
                failure_count="1"
                success_count="-1"
                _skipIf="led_battery_verdict != LED_BATTERY_CHARGING">
        <Delay delay_msec="300"
               _skipIf="current_battery_anim_id == CHARGING_BATTERY_ANIM_ID ||current_battery_anim_id == BATTERY_CHARGED_ANIM_ID">
          <CallSetLedAnimationService name="SetChargerInsertedAnimation"
                                      id="{CHARGER_INSERTED_ANIM_ID}"
                                      param=""
                                      repeating="false"
                                      service_name="led/set_animation"/>
        </Delay>
        <Delay delay_msec="2500"
               _skipIf="led_battery_full || (battery_percent_round == charging_anim_percent &amp;&amp; current_battery_anim_id == CHARGING_BATTERY_ANIM_ID)">
          <CallSetLedAnimationService name="SetChargingAnimation"
                                      id="{CHARGING_BATTERY_ANIM_ID}"
                                      param="{battery_percent_round}"
                                      repeating="true"
                                      service_name="led/set_animation"
                                      _onSuccess="charging_anim_percent = battery_percent_round; current_battery_anim_id = CHARGING_BATTERY_ANIM_ID"/>
        </Delay>
        <Delay delay_msec="2500"
               _skipIf="(!led_battery_full) || current_battery_anim_id == BATTERY_CHARGED_ANIM_ID">
          <CallSetLedAnimationService name="SetChargedAnimation"
                                      id="{BATTERY_CHARGED_ANIM_ID}"
                                      param="{battery_percent_round}"
                                      repeating="true"
                                      service_name="led/set_animation"
                                      _onSuccess="charging_anim_percent = battery_percent_round; current_battery_anim_id = BATTERY_CHARGED_ANIM_ID"/>
        </Delay>
      </Parallel>
      <Sequence name="DischargingSequence"
                _skipIf="led_battery_verdict != LED_BATTERY_DISCHARGING">
        <Sequence name="BatteryStatusSequence">
          <SafetyBtTickAfterTimeout timeout="{LOW_BATTERY_ANIM_PERIOD}"
                                    _skipIf="!led_battery_low">
            <CallSetLedAnimationService name="SetLowBatteryAnimation"
                                        id="{LOW_BATTERY_ANIM_ID}"
                                        param="{battery_percent_round}"
                                        repeating="false"
                                        service_name="led/set_animation"/>
          </SafetyBtTickAfterTimeout>
          <CallSetLedAnimationService name="SetCriticalBatteryAnimation"
                                      id="{CRITICAL_BATTERY_ANIM_ID}"
                                      param="{battery_percent_round}"
                                      repeating="true"
                                      service_name="led/set_animation"
                                      _skipIf="(!led_battery_critical) || current_battery_anim_id == CRITICAL_BATTERY_ANIM_ID"
                                      _onSuccess="current_battery_anim_id = CRITICAL_BATTERY_ANIM_ID"/>
          <CallSetLedAnimationService name="SetNominalBatteryAnimation"
                                      id="{BATTERY_NOMINAL_ANIM_ID}"
                                      param=""
                                      repeating="false"
                                      service_name="led/set_animation"
                                      _skipIf="(!led_battery_nominal) || current_battery_anim_id == BATTERY_NOMINAL_ANIM_ID"
                                      _onSuccess="current_battery_anim_id = BATTERY_NOMINAL_ANIM_ID"/>
        </Sequence>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ErrorAnimationSubtree">
    <Sequence name="ErrorSequence">
      <Sequence _skipIf="current_error_anim_id == ERROR_ANIM_ID">
        <CallSetLedAnimationService name="SetErrorAnimation"
                                    id="{ERROR_ANIM_ID}"
                                    param=""
                                    repeating="true"
                                    service_name="led/set_animation"
                                    _skipIf="led_error_verdict != LED_ERROR_CHARGING_OVERHEAT"
                                    _onSuccess="current_error_anim_id = ERROR_ANIM_ID"/>
        <CallSetLedAnimationService name="SetErrorAnimation"
                                    id="{ERROR_ANIM_ID}"
                                    param=""
                                    repeating="true"
                                    service_name="led/set_animation"
                                    _skipIf="led_error_verdict != LED_ERROR_STATUS_UNKNOWN"
                                    _onSuccess="current_error_anim_id = ERROR_ANIM_ID"/>
      </Sequence>
      <Sequence _skipIf="current_error_anim_id == NO_ERROR_ANIM_ID">
        <CallSetLedAnimationService name="SetNoErrorAnimation"
                                    id="{NO_ERROR_ANIM_ID}"
                                    param=""
                                    repeating="true"
                                    service_name="led/set_animation"
                                    _skipIf="led_error_verdict != LED_ERROR_NONE"
                                    _onSuccess="current_error_anim_id = NO_ERROR_ANIM_ID"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="RoverLedSafety">
    <Parallel failure_count="1"
              success_count="-1">
      <SubTree ID="ErrorAnimationSubtree"
               _autoremap="true"/>
      <SubTree ID="BatteryAnimationSubtree"
               _autoremap="true"/>
      <SubTree ID="StateAnimationSubtree"
               _autoremap="true"/>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="StateAnimationSubtree">
    <Sequence>
      <Sequence _skipIf="led_state_verdict == LED_STATE_E_STOP">
        <CallSetLedAnimationService name="SetReadyAnimation"
                                    id="{READY_ANIM_ID}"
                                    param=""
                                    repeating="true"
                                    service_name="led/set_animation"
                                    _skipIf="led_state_verdict != LED_STATE_READY || current_anim_id == READY_ANIM_ID"
                                    _onSuccess="current_anim_id = READY_ANIM_ID"/>
        <CallSetLedAnimationService name="SetManualActionAnimation"
                                    id="{MANUAL_ACTION_ANIM_ID}"
                                    param=""
                                    repeating="true"
                                    service_name="led/set_animation"
                                    _skipIf="led_state_verdict != LED_STATE_MANUAL_ACTION || current_anim_id == MANUAL_ACTION_ANIM_ID"
                                    _onSuccess="current_anim_id = MANUAL_ACTION_ANIM_ID"/>
      </Sequence>
      <CallSetLedAnimationService name="SetEStopAnimation"
                                  id="{E_STOP_ANIM_ID}"
                                  param=""
                                  repeating="true"
                                  service_name="led/set_animation"
                                  _skipIf="led_state_verdict != LED_STATE_E_STOP || current_anim_id == E_STOP_ANIM_ID"
                                  _onSuccess="current_anim_id = E_STOP_ANIM_ID"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="CallSetLedAnimationService"
            editable="true">
      <input_port name="id">animation ID</input_port>
      <input_port name="param">optional parameter</input_port>
      <input_port name="repeating"
                  default="false">indicates if animation should repeat</input_port>
      <input_port name="service_name">ROS service name</input_port>
      <input_port name="server_timeout">time in ms to wait for the response</input_port>
    </Action>
    <Decorator ID="SafetyBtTickAfterTimeout"
               editable="true">
      <input_port name="timeout">time in s to wait before ticking child again</input_port>
    </Decorator>
  </TreeNodesModel>

</root>