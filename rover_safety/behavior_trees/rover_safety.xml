<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!-- battery_verdict is computed by rover_safety::domain::evaluateBatterySafety. -->
  <BehaviorTree ID="RoverSafety">
    <Sequence>
      <Sequence name="BatteryTripEStopSequence"
                _skipIf="battery_verdict != VERDICT_TRIP_E_STOP">
        <CallTriggerService service_name="hardware_interface/sw_user_e_stop_set"
                            _skipIf="sw_e_stop_state"/>
      </Sequence>
      <Sequence name="BatteryShutdownSequence"
                _skipIf="battery_verdict != VERDICT_SHUTDOWN">
        <SignalShutdown reason="{battery_verdict_reason}"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="CallTriggerService"
            editable="true">
      <input_port name="service_name">ROS service name</input_port>
      <input_port name="server_timeout">time in ms to wait for the response</input_port>
    </Action>
    <Action ID="SignalShutdown"
            editable="true">
      <input_port name="reason">reason to shutdown robot</input_port>
    </Action>
  </TreeNodesModel>

</root>
