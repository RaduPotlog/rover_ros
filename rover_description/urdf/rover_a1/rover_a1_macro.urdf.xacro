<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro
    name="rover_a1_robot"
    params="wheel_config_file
            battery_config_file
            controller_config_file
            use_sim:=false
            imu_xyz:='0.0 0.0 0.0'
            imu_rpy:='0.0 0.0 0.0'
            lidar_xyz:='0.0 0.0 0.0'
            lidar_rpy:='0.0 0.0 0.0'
            namespace:=''">

    <xacro:if value="${use_sim}">
      <xacro:property name="imu_xyz" value="0.26 0.0 0.18" />
      <xacro:property name="imu_rpy" value="0.0 0.0 0.0" />
      <xacro:property name="lidar_xyz" value="0.0 0.0 0.0" />
      <xacro:property name="lidar_rpy" value="0.0 0.0 0.0" />
    </xacro:if>

    <xacro:property name="ns" value='${namespace + "/" if namespace else ""}' />
    <xacro:property name="wheel_config" value="${xacro.load_yaml(wheel_config_file)}" />
    <xacro:property name="wheelbase" value="0.2542" />
    <xacro:property name="wheel_mount_point_y" value="0.31301" />

    <!-- Rover base macros -->
    <xacro:include filename="$(find rover_description)/urdf/rover_a1/base.urdf.xacro" ns="body" />
    <!-- Rover wheel macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/wheel.urdf.xacro" ns="wheel" />

    <xacro:if value="${use_sim}">
      <!-- Battery macros -->
      <xacro:include filename="$(find rover_description)/urdf/common/battery.urdf.xacro" ns="battery" />
    </xacro:if>
    
    <!-- IMU macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/imu.urdf.xacro" ns="imu" />
    <!-- Lidar macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/lidar.urdf.xacro" ns="lidar" />
    <!-- Gazebo system macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/gazebo_system.urdf.xacro" ns="gazebo_system" />
    
    <!-- Rover body -->
    <xacro:body.body
      wheel_radius="${wheel_config['wheel_radius']}"
      imu_xyz="${imu_xyz}"
      imu_rpy="${imu_rpy}"
      lidar_xyz="${lidar_xyz}"
      lidar_rpy="${lidar_rpy}" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheelbase}"
      mount_point_y="${wheel_mount_point_y}"
      prefix="fl" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheelbase}"
      mount_point_y="${wheel_mount_point_y}"
      prefix="fr" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheelbase}"
      mount_point_y="${wheel_mount_point_y}"
      prefix="rl" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheelbase}"
      mount_point_y="${wheel_mount_point_y}"
      prefix="rr" />

    <!-- ROS2 Controller -->
    <ros2_control name="${ns}rover_system_node" type="system">
      <!-- Joints -->
      <joint name="fl_wheel_base_to_fl_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="fr_wheel_base_to_fr_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="rl_wheel_base_to_rl_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="rr_wheel_base_to_rr_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      
      <xacro:if value="${use_sim}">
        <!-- IMU interfaces -->
        <xacro:imu.imu_interface use_sim="${use_sim}" namespace="${namespace}" />
      </xacro:if>
      
      <!-- Hardware controller plugin -->
      <hardware>
        <xacro:if value="${use_sim}">
          <!-- Gazebo simulation system contorller -->
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:unless value="${use_sim}">
          <!-- Hardware controller system interface -->
          <plugin>rover_hardware_interface/RoverA1System</plugin>

          <!-- Modbus TCP endpoint for the safety controller (E-Stop / GPIO) -->
          <param name="modbus_host">192.168.88.11</param>
          <param name="modbus_port">502</param>
          <!-- 0 = retry the initial Modbus connection forever (blocking on_configure() until
               reachable, matching the previous hardcoded behavior). Set to a positive count to
               instead fail on_configure() cleanly after that many attempts. -->
          <param name="modbus_connection_retry_count">0.0</param>
          <param name="modbus_connection_retry_delay_ms">1000.0</param>

          <!-- Driver controller update frequency and maximum attempts to initilize and activate -->
          <param name="driver_states_update_frequency">20.0</param>
          <param name="max_rover_driver_initialization_attempts">3.0</param>
          <param name="max_rover_driver_activation_attempts">3.0</param>

          <!-- Consecutive-cycle thresholds for the RoverErrorFilter: number of consecutive
               failed/faulty cycles before a category latches into an active (debounced) error.
               Reported only via diagnostics ("system errors" task) and the error/comm_error
               message fields - never gates read()/write() return codes or triggers a lifecycle
               transition. The fault-flag category has no URDF param: it is hardcoded to 1
               (immediate escalation, no debounce). -->
          <param name="max_write_cmds_errors_count">2</param>
          <param name="max_read_motor_states_errors_count">2</param>
          <param name="max_read_driver_state_errors_count">2</param>

          <!-- Max time (ms) since the last Phidget SDK telemetry callback (position/current/
               temperature) before a wheel driver is considered to have a communication error
               (e.g. a USB disconnect). Tune against the measured minDataInterval on the real
               boards if false positives/slow detection are observed. -->
          <param name="driver_comm_timeout_ms">300</param>

          <!-- Motor parameters -->
          <param name="motor_torque_constant">0.11</param>
          <param name="max_rpm_motor_speed">2800</param>
          <param name="gear_ratio">23.3</param>
          <param name="gearbox_efficiency">0.70</param>
          <!-- Encoder parameters -->
          <param name="encoder_resolution">1024</param>

        </xacro:unless>
      </hardware>
    </ros2_control>

    <!-- Instantiate IMU -->
    <xacro:imu.imu use_sim="${use_sim}" reference_frame="imu_link" namespace="${namespace}" />
    <!-- Instantiate LIDAR -->
    <xacro:lidar.lidar use_sim="${use_sim}" reference_frame="lidar_link" namespace="${namespace}" />

    <xacro:if value="${use_sim}">
      <!-- Instantiate Battery -->
      <xacro:battery.battery battery_config_file="${battery_config_file}" namespace="${namespace}" />
      <!-- Instantiate Gazebo System -->
      <xacro:gazebo_system.controller controller_config_file="${controller_config_file}" namespace="${namespace}" />
    </xacro:if>

  </xacro:macro>

</robot>