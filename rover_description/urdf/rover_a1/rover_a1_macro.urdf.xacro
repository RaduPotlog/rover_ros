<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro
    name="rover_a1_robot"
    params="wheel_config_file
            battery_config_file
            controller_config_file
            use_sim:=false
            imu_xyz:='0.0 0.0 0.0'
            imu_rpy:='0.0 0.0 0.0'
            lidar_xyz:='0.0 0.0 0.0'
            lidar_rpy:='0.0 0.0 0.0'
            gps_xyz:='0.0 0.0 0.0'
            gps_rpy:='0.0 0.0 0.0'
            namespace:=''">

    <xacro:if value="${use_sim}">
      <xacro:property name="imu_xyz" value="-0.09 0.0 0.2" />
      <xacro:property name="imu_rpy" value="0.0 0.0 0.0" />
      <!-- Keep the ROVER_LIDAR_* mount when one is set; with the all-zero default the
           gpu_lidar would sit inside the body mesh (top at z = 0.241), so lift it above.
           Its lowest ring (-15 deg) must clear the body's far corner (0.47 m out), which
           needs >= 0.126 m above the top; 0.45 gives 0.21 m. Lower, the rover sees itself
           and the costmaps mark obstacles inside the footprint. -->
      <xacro:if value="${[float(v) for v in str(lidar_xyz).split()] == [0.0, 0.0, 0.0]}">
        <xacro:property name="lidar_xyz" value="0.0 0.0 0.45" />
      </xacro:if>
    </xacro:if>

    <xacro:property name="ns" value='${namespace + "/" if namespace else ""}' />
    <xacro:property name="wheel_config" value="${xacro.load_yaml(wheel_config_file)}" />
    <!-- wheelbase and wheel_separation are full centre-to-centre distances, so each
         mount point sits at half of them (REP-103: +x forward, +y left, +z up). -->
    <xacro:property name="wheel_mount_point_x" value="${wheel_config['wheelbase'] / 2.0}" />
    <xacro:property name="wheel_mount_point_y" value="${wheel_config['wheel_separation'] / 2.0}" />
    <!-- Height of the wheel axis above body_link; also fixes the ground plane. -->
    <xacro:property name="wheel_mount_point_z" value="0.033" />

    <!-- Rover base macros -->
    <xacro:include filename="$(find rover_description)/urdf/rover_a1/base.urdf.xacro" ns="body" />
    <!-- Rover wheel macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/wheel.urdf.xacro" ns="wheel" />

    <xacro:if value="${use_sim}">
      <!-- Battery macros -->
      <xacro:include filename="$(find rover_description)/urdf/common/battery.urdf.xacro" ns="battery" />
    </xacro:if>
    
    <!-- IMU macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/imu.urdf.xacro" ns="imu" />
    <!-- Lidar macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/lidar.urdf.xacro" ns="lidar" />
    <!-- GPS macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/gps.urdf.xacro" ns="gps" />
    <!-- Gazebo system macros -->
    <xacro:include filename="$(find rover_description)/urdf/common/gazebo_system.urdf.xacro" ns="gazebo_system" />
    
    <!-- Rover body -->
    <xacro:body.body
      wheel_radius="${wheel_config['wheel_radius']}"
      wheel_mount_point_z="${wheel_mount_point_z}"
      imu_xyz="${imu_xyz}"
      imu_rpy="${imu_rpy}"
      lidar_xyz="${lidar_xyz}"
      lidar_rpy="${lidar_rpy}"
      gps_xyz="${gps_xyz}"
      gps_rpy="${gps_rpy}"
      use_sim="${use_sim}" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="fl" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="fr" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="rl" />

    <!-- Rover wheel -->
    <xacro:wheel.wheel
      config="${wheel_config}"
      mount_point_x="${wheel_mount_point_x}"
      mount_point_y="${wheel_mount_point_y}"
      mount_point_z="${wheel_mount_point_z}"
      prefix="rr" />

    <!-- ROS2 Controller -->
    <ros2_control name="${ns}rover_system_node" type="system">
      <!-- Joints -->
      <joint name="fl_wheel_base_to_fl_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="fr_wheel_base_to_fr_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="rl_wheel_base_to_rl_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="rr_wheel_base_to_rr_wheel_joint">
        <command_interface name="velocity" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      
      <xacro:if value="${use_sim}">
        <!-- IMU interfaces -->
        <xacro:imu.imu_interface use_sim="${use_sim}" namespace="${namespace}" />
      </xacro:if>
      
      <!-- Hardware controller plugin -->
      <hardware>
        <xacro:if value="${use_sim}">
          <!-- Gazebo simulation system contorller -->
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:unless value="${use_sim}">
          <!-- Hardware controller system interface -->
          <plugin>rover_hardware_interface/RoverA1System</plugin>

          <!-- Modbus TCP endpoint for the safety controller (E-Stop / GPIO) -->
          <param name="modbus_host">192.168.88.11</param>
          <param name="modbus_port">502</param>
          <!-- 0 = retry the initial Modbus connection forever (blocking on_configure() until
               reachable, matching the previous hardcoded behavior). Set to a positive count to
               instead fail on_configure() cleanly after that many attempts. -->
          <param name="modbus_connection_retry_count">0</param>
          <param name="modbus_connection_retry_delay_ms">1000</param>
          <!-- Per-transaction Modbus response timeout (ms). Bounds how long one stalled read or
               write can hold the safety link and delay the watchdog heartbeat below, so it must
               stay comfortably under safety_wdg_kick_period_ms. Optional - omitting it keeps the
               compiled-in kDefaultResponseTimeoutMs (500), which is longer than a kick period
               and is why a single slow transaction used to be able to trip the relay. -->
          <param name="modbus_response_timeout_ms">150</param>

          <!-- Period (ms) of the CPU watchdog heartbeat toggle on GPIO_CPU_WDG_HEARTBEAT
               (COIL_1). The safety relay latches the E-Stop if this level stops changing for
               longer than its watchdog window, measured at ~1 s on the A1, so this value is
               dimensioned against real hardware and is not a free tuning knob: 200 ms gives ~5x
               margin, enough to absorb several consecutive ticks lost to Modbus contention. The
               heartbeat runs on its own thread with absolute steady_clock deadlines and does not
               share a lock hold with the IO poll below. Raise only with a re-measured window;
               lowering it costs Modbus bandwidth but is otherwise safe. -->
          <param name="safety_wdg_kick_period_ms">200</param>

          <!-- Period (ms) of the discrete-IO poll that refreshes the cache read() serves to
               GpioState and the E-Stop mirror. Telemetry only - a missed poll degrades freshness
               and is caught by rover_twist_mux's 1.0 s gpio_state staleness timeout; it never
               endangers the relay's watchdog window. 100 ms keeps link duty low; it is also the
               floor on how quickly software notices a latch trip, which is defense-in-depth
               behind the contactor opening in hardware. -->
          <param name="safety_io_poll_period_ms">100</param>

          <!-- How long (ms) the latch-reset coil is held true before being driven back to false.
               The reset is a pulse, not a level; it used to be written true-then-false with no
               dwell, making it one Modbus round-trip wide and narrower than anyone had checked
               against the relay's discrete-input filter. A pulse the relay cannot see fails
               silently - the service returns success and the latch stays held. Optional;
               omitting it keeps kDefaultLatchResetPulseMs (100). Narrow it only against a
               scope measurement of the relay input. -->
          <param name="safety_latch_reset_pulse_ms">100</param>

          <!-- Driver controller update frequency and maximum attempts to initilize and activate -->
          <param name="driver_states_update_frequency">20.0</param>
          <param name="max_rover_driver_initialization_attempts">3</param>
          <param name="max_rover_driver_activation_attempts">3</param>

          <!-- Consecutive-cycle thresholds for the RoverErrorFilter: number of consecutive
               failed/faulty cycles before a category latches into an active (debounced) error.
               Reported only via diagnostics ("system errors" task) and the error/comm_error
               message fields - never gates read()/write() return codes or triggers a lifecycle
               transition. The fault-flag category has no URDF param: it is hardcoded to 1
               (immediate escalation, no debounce). -->
          <param name="max_write_cmds_errors_count">2</param>
          <param name="max_read_motor_states_errors_count">2</param>
          <param name="max_read_driver_state_errors_count">2</param>

          <!-- Max time (ms) since the last Phidget SDK telemetry callback (position/current/
               temperature) before a wheel driver is considered to have a communication error
               (e.g. a USB disconnect). Tune against the measured minDataInterval on the real
               boards if false positives/slow detection are observed. -->
          <param name="driver_comm_timeout_ms">300</param>

          <!-- Max time (ms) a PhidgetDCMotor_setTargetVelocity_async() command may go unsent/
               unacknowledged before the Phidget board's own hardware watchdog disengages (brakes)
               the motor, independent of software E-Stop state - a defense-in-depth backstop for
               e.g. a hung RT loop. write() keeps feeding it with zero commands while motion is
               inhibited (E-Stop), so only a stalled write() loop trips it. A trip is latched (motor_failsafe_tripped_error in
               diagnostics) and only cleared by the hardware_interface/sw_e_stop_latch_reset
               service. Optional - omitting it keeps the compiled-in
               kDefaultMotorFailsafeTimeoutMs (500). Tune at bench test: short enough to be a
               meaningful backstop, long enough that ordinary write() cycle jitter never trips
               it. -->
          <param name="motor_failsafe_timeout_ms">500</param>

          <!-- On-board duty-cycle ramp of each DCC1000, in duty/s (DCC1000 range 0.5-10000).
               2.0 = up to 0.5 s from stop to full duty, a lag the ROS side can't see. Optional -
               omitting it keeps the compiled-in kDefaultMotorAcceleration (2.0). Once the wheel
               PID loop owns the speed dynamics, raise it after measuring the step response. -->
          <param name="motor_acceleration">80.0</param>

          <!-- DCC1000 motor current limit in A (device range 2-25). The motor stalls at 16 A on
               24 V, and a direction reversal can briefly reach ~2x stall as back-EMF adds to the
               supply, so the limit is what protects motor, DCC1000 and gearbox. 10 A gives ~60 %
               of stall torque with thermal headroom. Optional - omitting it keeps the compiled-in
               kDefaultMotorCurrentLimit (10.0). -->
          <param name="motor_current_limit">15.0</param>

          <!-- Motor supply voltage in V (DCC1000 range 8-30). Only used to derive the current
               regulator gain = motor_current_limit * (motor_supply_voltage / 12) (Phidget rule of
               thumb) = 20 here. Too low a gain causes current spikes / jerky torque, too high a
               rough-sounding motor on reversals. Optional - omitting it keeps the compiled-in
               kDefaultMotorSupplyVoltage (24.0). -->
          <param name="motor_supply_voltage">24.0</param>

          <!-- Motor parameters -->
          <param name="motor_torque_constant">0.11</param>
          <param name="max_rpm_motor_speed">2800</param>
          <param name="gear_ratio">23.3</param>
          <param name="gearbox_efficiency">0.70</param>
          <!-- The Phidget driver reports raw current feedback in milliamps (see
               PhidgetMotorDriver::currentChangeHandler); this scales
               it to amps before it's combined with motor_torque_constant/gear_ratio/
               gearbox_efficiency to compute torque (see domain/driver_data_snapshot.cpp). A
               different driver backend would supply its own raw-current unit scale here. -->
          <param name="raw_current_to_amps_scale">0.001</param>
          <!-- Encoder parameters -->
          <param name="encoder_resolution">1024</param>

          <!-- Deadband (rad/s at the wheel) below which a velocity command counts as zero for
               the "can't clear the E-Stop while the rover is still being commanded to move"
               invariant (see domain/emergency_stop.cpp). Optional: omitting it keeps the
               compiled-in kDefaultVelocityCommandZeroTolerance (0.01).

               Why 0.35 and not 0.01: the wheel PIDs run with feedforward_gain 1.0 and an
               integral clamped at i_clamp_max (0.25 front, 0.33 rear - see
               rover_controller/config/wheel_01_controller.yaml). While motion is inhibited the
               reference and the measured velocity are both zero, so the PID error is zero, and a
               PI integrator holds its value at zero error instead of decaying. The command
               therefore parks at the frozen I-term - up to 0.33 rad/s - and no command-side
               tolerance below that can ever be satisfied. 0.35 is the smallest value that clears
               the largest i_clamp with a little margin.

               This was previously 1.2 (~0.2 m/s at the A1's 0.1651 m wheel radius), which is
               fast enough to walk beside and made the invariant largely decorative. The way to
               get back to 0.01 is to reset the PID I-term when motion is inhibited, not to keep
               widening this - hence velocity_state_zero_tolerance below, which closes the real
               hazard in the meantime. -->
          <param name="velocity_command_zero_tolerance">0.35</param>

          <!-- Deadband (rad/s at the wheel) below which a *measured* wheel velocity counts as
               "not moving", the second half of the same invariant. Unlike the command check
               above this has no PID artifact to work around - a stationary wheel reads zero
               whatever the integrator remembers - so it is the condition that actually prevents
               clearing the E-Stop while the rover is still rolling. Optional; omitting it keeps
               kDefaultVelocityStateZeroTolerance (0.05). 0.05 rad/s is ~8 mm/s, above 20 Hz
               encoder quantisation and far below walking pace. -->
          <param name="velocity_state_zero_tolerance">0.05</param>

        </xacro:unless>
      </hardware>
    </ros2_control>

    <!-- Instantiate IMU -->
    <xacro:imu.imu use_sim="${use_sim}" reference_frame="imu_link" namespace="${namespace}" />
    <!-- Instantiate LIDAR -->
    <xacro:lidar.lidar use_sim="${use_sim}" reference_frame="lidar_link" namespace="${namespace}" />
    <!-- Instantiate GPS -->
    <xacro:gps.gps use_sim="${use_sim}" reference_frame="gps_link" namespace="${namespace}" />

    <xacro:if value="${use_sim}">
      <!-- Instantiate Battery -->
      <xacro:battery.battery battery_config_file="${battery_config_file}" namespace="${namespace}" />
      <!-- Instantiate Gazebo System -->
      <xacro:gazebo_system.controller controller_config_file="${controller_config_file}" namespace="${namespace}" />
    </xacro:if>

  </xacro:macro>

</robot>