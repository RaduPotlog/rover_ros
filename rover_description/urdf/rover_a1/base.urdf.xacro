<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro
    name="body"
    params="wheel_radius
            wheel_mount_point_z
            imu_xyz 
            imu_rpy
            lidar_xyz
            lidar_rpy
            gps_xyz
            gps_rpy
            use_sim:=false">

    <!-- REP-105 root: ground projection of base_link. The odometry filters publish
         odom -> base_footprint, so in 2D mode odom stays on the ground plane. -->
    <link name="base_footprint" />

    <!-- base_link sits above the ground by the wheel radius minus the axis offset. -->
    <joint name="footprint_to_base_joint" type="fixed">
      <origin xyz="0.0 0.0 ${wheel_radius - wheel_mount_point_z}" rpy="0.0 0.0 0.0" />
      <parent link="base_footprint" />
      <child link="base_link" />
    </joint>

    <link name="base_link" />

    <joint name="base_to_body_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <parent link="base_link" />
      <child link="body_link" />
    </joint>

    <link name="body_link">
      <visual>
        <geometry>
          <mesh filename="package://rover_description/meshes/rover_a1/base.stl" />
        </geometry>
      </visual>

      <!-- Simulation only: a box over the base.stl bounds (x +/-0.351, y +/-0.313,
           z -0.015..0.241) so the body hits obstacles in Gazebo. Gazebo does not
           self-collide a model's links, so it cannot fight the wheels. -->
      <xacro:if value="${use_sim}">
        <collision>
          <origin xyz="0.0 0.0 0.113" rpy="0.0 0.0 0.0" />
          <geometry>
            <box size="0.702 0.626 0.256" />
          </geometry>
        </collision>
      </xacro:if>

      <inertial>
        <origin xyz="-0.0352516654672473 0.000230769565957786 0.0766816513547671" rpy="0 0 0" />
        <mass value="33.445952" />
        <inertia ixx="0.233794970398492" ixy="-0.000820762950210979" ixz="1.94037912313266E-05"
                 iyy="0.228604041647293" iyz="3.84951327810773E-08" izz="0.363260170153768" />
      </inertial>
    </link>

    <joint name="body_to_imu_joint" type="fixed">
      <origin xyz="${imu_xyz}" rpy="${imu_rpy}" />
      <parent link="body_link" />
      <child link="imu_link" />
    </joint>

    <link name="imu_link" />

    <joint name="body_to_lidar_joint" type="fixed">
      <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}" />
      <parent link="body_link" />
      <child link="lidar_link" />
    </joint>

    <link name="lidar_link" />

    <!-- GNSS antenna of the RUTX11 (frame_id of gps/fix); navsat_transform uses this offset. -->
    <joint name="body_to_gps_joint" type="fixed">
      <origin xyz="${gps_xyz}" rpy="${gps_rpy}" />
      <parent link="body_link" />
      <child link="gps_link" />
    </joint>

    <link name="gps_link" />

  </xacro:macro>
</robot>