<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro
    name="body"
    params="wheel_radius
            wheel_mount_point_z
            imu_xyz 
            imu_rpy
            lidar_xyz
            lidar_rpy
            gps_xyz
            gps_rpy
            camera_xyz:='0.25 0.0 0.2'
            camera_rpy:='0.0 0.0 0.0'
            use_sim:=false">

    <!-- REP-105 root: ground projection of base_link. The odometry filters publish
         odom -> base_footprint, so in 2D mode odom stays on the ground plane. -->
    <link name="base_footprint" />

    <!-- base_link sits above the ground by the wheel radius minus the axis offset. -->
    <joint name="footprint_to_base_joint" type="fixed">
      <origin xyz="0.0 0.0 ${wheel_radius - wheel_mount_point_z}" rpy="0.0 0.0 0.0" />
      <parent link="base_footprint" />
      <child link="base_link" />
    </joint>

    <link name="base_link" />

    <joint name="base_to_body_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <parent link="base_link" />
      <child link="body_link" />
    </joint>

    <link name="body_link">
      <!-- base.stl is the SolidWorks base_link.STL (solidworks_exported/
           ROVER_1000_WATT_VARIANT.SLDASM) decimated 4x; body_link is its CAD frame. -->
      <visual>
        <geometry>
          <mesh filename="package://rover_description/meshes/rover_a1/base.stl" />
        </geometry>
        <material name="">
          <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
        </material>
      </visual>

      <!-- Simulation only: boxes over the base.stl bounds so the body hits obstacles in
           Gazebo - the main body (x -0.410..0.413, y +/-0.27, z -0.02..0.30) and the front
           arch (x 0.161..0.251, y +/-0.253, z 0.30..0.555). Gazebo does not self-collide a
           model's links, so they cannot fight the wheels. -->
      <xacro:if value="${use_sim}">
        <collision>
          <origin xyz="0.0015 0.0 0.14" rpy="0.0 0.0 0.0" />
          <geometry>
            <box size="0.823 0.54 0.32" />
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.206 0.0 0.4275" rpy="0.0 0.0 0.0" />
          <geometry>
            <box size="0.09 0.506 0.255" />
          </geometry>
        </collision>
      </xacro:if>

      <!-- From the SolidWorks export (base_link row of solidworks_exported/.../urdf/*.csv),
           except the mass. The exporter ignores user-overridden part masses and weighs the 4
           DCC1000 motor controllers at their 1060 Alloy material mass (141.9 g) instead of
           the 78.8 g override (an ASSUMPTION in the CAD, not weighed). Mass = exported
           37.2298 - 4 x 0.06306 = 36.9775 kg, matching the CAD assembly (57.274 kg total).
           CoM and inertia are left as exported (error well below 1 %). -->
      <inertial>
        <origin xyz="0.0160214617664491 -0.000470435452859783 0.107817531003205" rpy="0 0 0" />
        <mass value="36.9775262386666" />
        <inertia ixx="0.327697897335902" ixy="-0.000815380156152649" ixz="3.69646892519238E-06"
                 iyy="0.314462293606544" iyz="-5.45800544682604E-05" izz="0.57169437099185" />
      </inertial>
    </link>

    <joint name="body_to_imu_joint" type="fixed">
      <origin xyz="${imu_xyz}" rpy="${imu_rpy}" />
      <parent link="body_link" />
      <child link="imu_link" />
    </joint>

    <link name="imu_link" />

    <joint name="body_to_lidar_joint" type="fixed">
      <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}" />
      <parent link="body_link" />
      <child link="lidar_link" />
    </joint>

    <link name="lidar_link" />

    <!-- GNSS antenna of the RUTX11 (frame_id of gps/fix); navsat_transform uses this offset. -->
    <joint name="body_to_gps_joint" type="fixed">
      <origin xyz="${gps_xyz}" rpy="${gps_rpy}" />
      <parent link="body_link" />
      <child link="gps_link" />
    </joint>

    <link name="gps_link" />

    <!-- RealSense D435i. camera_link is the driver's TF root (REP-103, x forward): the realsense
         node publishes camera_link -> optical frames itself. Mount pose is an ASSUMPTION until
         measured on the rover; override with ROVER_CAMERA_LOCALIZATION_* / ROVER_CAMERA_ORIENTATION_*.
         The frame always exists so the TF tree does not change when ROVER_USE_CAMERA toggles. -->
    <joint name="body_to_camera_joint" type="fixed">
      <origin xyz="${camera_xyz}" rpy="${camera_rpy}" />
      <parent link="body_link" />
      <child link="camera_link" />
    </joint>

    <link name="camera_link" />

  </xacro:macro>
</robot>