<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_crsf_teleop</name>
  <version>2.0.0</version>
  <description>CRSF (ExpressLRS) RC teleop for the rover: decodes the receiver's CRSF stream, forwarded
    over UDP by the RUTX11 router and received by rover_udp_driver, maps sticks to cmd_vel and switches to the SW E-Stop, with an
    RC link failsafe.</description>
  <maintainer email="potlogradu@gmail.com">radupotlog</maintainer>
  <license>Apache License 2.0</license>
  <license file="THIRD_PARTY_LICENSES">MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_srvs</depend>
  <!-- UdpPacket: the raw CRSF datagrams published by rover_udp_driver's receiver node. -->
  <depend>udp_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- RcChannels / RcLinkStatus, echoed on rc/channels and rc/link for tuning. -->
  <depend>rover_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- Runtime only: this package's launch file starts rover_udp_driver's receiver node to own the
       socket, but links none of its code - so no asio and no rover_io_context in this build. Hardware
       only: in simulation there is no receiver and the launch file skips the node. -->
  <exec_depend condition="$ROVER_ROS_BUILD_TYPE == hardware">rover_udp_driver</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rclpy</test_depend>
  <!-- The e2e test feeds the teleop node through a real UDP socket. -->
  <test_depend>rover_udp_driver</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
