<?xml version="1.0"?>

<sdf version="1.6">
  <world name="rover_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <!-- Feeds the navsat sensor (simulated GNSS); needs <spherical_coordinates> below. -->
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>50.088384</latitude_deg>
      <longitude_deg>19.939128</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="rover_world">
      <static>true</static>
      
      <link name="map">
        <light type="directional" name="sun">
          <cast_shadows>true</cast_shadows>
          <pose>0 0 10 0 0 0</pose>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
          </attenuation>
          <direction>-0.5 0.1 -0.9</direction>
        </light>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 25</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 25</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static obstacles so the lidar, costmaps and SLAM have structure to work with.
         Perimeter walls at +/-11 m, plus a few boxes and pillars around the spawn point
         (0, -2). Heights span the RS16 slice (+/-0.25 m around the lidar). -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 11 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>22 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22 0.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -11 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>22 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22 0.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>11 0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 22 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 22 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-11 0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 22 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 22 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_1">
      <static>true</static>
      <pose>3 1 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.8</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-3 3 0.4 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.6 0.8</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_3">
      <static>true</static>
      <pose>5 -5 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 2.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 2.5 0.8</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_4">
      <static>true</static>
      <pose>-5 -4 0.6 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 1.2</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>0 5 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-7 7 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>7 6 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
